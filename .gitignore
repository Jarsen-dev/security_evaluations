# ---------------------------------------------------------------------------
# Sistema de Evaluación de Conocimientos
# OJO: no agregar patrones genéricos como `lib/`, `build/`, `dist/` o `var/`
# sin anclarlos a una ruta: `lib/` excluiría `frontend/src/lib/`, donde viven
# api.ts y types.ts.
# ---------------------------------------------------------------------------

# --- Entorno y secretos ---------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Python / backend -----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/build/
backend/dist/
backend/*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / Next.js / frontend --------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
.pnp
.pnp.js
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
next-env.d.ts
*.tsbuildinfo

# --- Docker y datos -------------------------------------------------------
backups/*.sql.gz
backups/*.dump
pgdata/

# --- Sistema operativo y editores -----------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Logs -----------------------------------------------------------------
*.log
logs/

# Espejo de los formatos que aprende el OCR: son remisiones reales de
# proveedores y no tienen por qué viajar en el repositorio.
backend/ocr_formatos/
