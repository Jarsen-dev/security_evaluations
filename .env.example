# ===========================================================================
# Sistema de Evaluación de Conocimientos — configuración de entorno
#
# Copia este archivo a `.env` y ajusta los valores:
#     cp .env.example .env
#
# El archivo `.env` NUNCA se sube a git (ver .gitignore).
# ===========================================================================

# ---------------------------------------------------------------------------
# Puertos expuestos en el host
#
# Estos puertos fueron verificados como libres en el servidor. Si los cambias,
# revisa antes con:  ss -tulpn | grep :PUERTO
#
# Puertos YA OCUPADOS por otros proyectos del servidor (no usar):
#   3000, 8000, 5433, 5050  -> proyecto `produccion`
#   3001, 8001              -> proyecto `prueba-rh`
#   80                      -> nginx del host
#   5432                    -> postgres del host
#   11434                   -> ollama
# ---------------------------------------------------------------------------

# Puerto del frontend Next.js. En producción NO se expone al host
# (todo el tráfico entra por NGINX_PORT); se usa en el compose de desarrollo.
FRONTEND_PORT=3200

# Puerto del backend FastAPI. En producción NO se expone al host;
# se usa en el compose de desarrollo para pegarle directo a la API.
BACKEND_PORT=8200

# Puerto de PostgreSQL. En producción NO se expone al host (solo la red
# interna de Docker lo alcanza); se usa en el compose de desarrollo para
# conectarse con psql o pgAdmin.
POSTGRES_PORT=5442

# Puerto de pgAdmin. A DIFERENCIA de los anteriores, este SÍ se publica en
# producción: es a donde apuntan los botones de la pestaña de Mantenimiento.
# Queda alcanzable solo desde la LAN de la planta — el túnel de Cloudflare
# no lo publica y el puerto NO debe abrirse en ufw hacia internet.
# El 5050 (el default de pgAdmin) ya lo ocupa otro proyecto del servidor.
PGADMIN_PORT=5150

# Puerto de Nginx: ES EL ÚNICO PUNTO DE ENTRADA en producción.
# Es el puerto que va en la URL que se comparte a los empleados.
NGINX_PORT=8080

# ---------------------------------------------------------------------------
# Base de datos PostgreSQL 16
# ---------------------------------------------------------------------------

POSTGRES_USER=evaluaciones
POSTGRES_PASSWORD=cambia_esta_contrasena_en_produccion
POSTGRES_DB=evaluaciones

# URL de conexión async que usa SQLAlchemy/asyncpg.
# El host `db` es el nombre del servicio en docker-compose, no `localhost`.
DATABASE_URL=postgresql+asyncpg://evaluaciones:cambia_esta_contrasena_en_produccion@db:5432/evaluaciones

# ---------------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------------

# Entorno de ejecución: `production` o `development`.
#
# En `production` no se sirve la documentación interactiva de la API
# (/api/docs y /api/openapi.json): describe todos los endpoints del panel y,
# con el sistema publicado en internet por el túnel, no tiene por qué estar
# a la vista.
ENVIRONMENT=production

# Llave para firmar los JWT del administrador. Genera una propia con:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la cambias, todas las sesiones abiertas se invalidan.
SECRET_KEY=genera_una_llave_con_el_comando_del_comentario

# Horas de validez del token de sesión del admin.
ACCESS_TOKEN_EXPIRE_HOURS=12

# Marca la cookie de sesión como `Secure` (solo se envía por HTTPS).
#
# En `true` porque todo el acceso —panel incluido— entra por el dominio del
# túnel de Cloudflare, que sirve HTTPS. Si alguna vez hay que administrar
# entrando directo por la IP de la LAN (http://192.168.1.78:8080), el
# navegador descartará la cookie y el login no funcionará por esa vía:
# regrésalo a `false` mientras dure esa necesidad.
COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------

# URL base con la que se arma el código QR y la liga pública de los
# cuestionarios: el dominio público del túnel de Cloudflare. Así el QR abre
# con datos móviles y no solo desde la WiFi de planta.
#
# CRÍTICO: si aquí queda `localhost` o `127.0.0.1`, el QR apunta al propio
# celular del operador y la liga no abre.
#
# Este valor es también el único origen que acepta CORS, y Next.js lo
# incrusta en el bundle durante el build: si lo cambias hay que reconstruir
# el frontend (`docker-compose up -d --build frontend`), no basta reiniciarlo.
NEXT_PUBLIC_BASE_URL=https://evaluaciones.chwon.it.com

# ---------------------------------------------------------------------------
# Red WiFi de planta (opcional)
# ---------------------------------------------------------------------------
#
# Con estos datos el panel genera un segundo código QR, junto al del
# cuestionario, para que el operador se conecte a la red escaneándolo en vez
# de teclear la contraseña.
#
# Se pueden dejar vacías: el modal simplemente no muestra ese QR.
#
# IMPORTANTE: estas variables NO llevan el prefijo NEXT_PUBLIC_ a propósito.
# Con ese prefijo, Next.js las incrustaría en el JavaScript que descarga
# cualquiera, incluidos los operadores del formulario público, y la
# contraseña de la red quedaría a la vista. Así, solo viajan al panel de
# administración y con sesión iniciada.
#
# Recomendación: usa la red de invitados, no la de producción.

# Nombre de la red, tal como aparece al buscar WiFi.
WIFI_SSID=

# Contraseña de la red.
WIFI_PASSWORD=

# Tipo de seguridad: WPA (cubre WPA/WPA2/WPA3), WEP o nopass (red abierta).
WIFI_SEGURIDAD=WPA

# true solo si la red no difunde su nombre.
WIFI_OCULTA=false

# ---------------------------------------------------------------------------
# Límite de tasa de los endpoints públicos
# ---------------------------------------------------------------------------

# Máximo de peticiones por IP dentro de la ventana. El default de 30/minuto
# alcanza de sobra para una persona contestando (1 inicio + 1 por pregunta +
# 1 envío).
#
# OJO: si la WiFi de planta hace NAT, todos los celulares llegan con la MISMA
# IP y se bloquearían entre ellos. En ese caso sube este valor o desactiva el
# NAT para el segmento de los operadores.
#
# El límite se aplica por worker de uvicorn (son 4), así que el tope efectivo
# por IP es aproximadamente 4 veces este número.
RATE_LIMIT_PETICIONES=30
RATE_LIMIT_VENTANA_SEGUNDOS=60

# ---------------------------------------------------------------------------
# Límite de tasa del login
# ---------------------------------------------------------------------------

# Intentos de acceso FALLIDOS que se toleran por IP antes de responder 429.
# Un login correcto no consume cuota, así que un admin no se autobloquea por
# entrar varias veces al día.
#
# Es la defensa contra el descubrimiento de contraseña por fuerza bruta ahora
# que el login es alcanzable desde internet. También aquí el límite es por
# worker de uvicorn (son 4): el tope real por IP es ~4 veces este número, que
# aun así deja el ataque en decenas de intentos por hora en vez de cientos
# por minuto.
RATE_LIMIT_LOGIN_INTENTOS=5
RATE_LIMIT_LOGIN_VENTANA_SEGUNDOS=300

# ---------------------------------------------------------------------------
# Reglas de negocio
# ---------------------------------------------------------------------------

# Porcentaje mínimo para considerar aprobado un intento. Se usa en los KPIs
# del dashboard y en las exportaciones de Excel y PowerPoint.
UMBRAL_APROBACION=70

# ---------------------------------------------------------------------------
# Zona horaria
# ---------------------------------------------------------------------------

# Zona del reloj de la planta. La bitácora se guarda en UTC (TIMESTAMPTZ),
# pero los filtros de "hora desde" y "hora hasta" del panel se comparan
# convirtiendo a esta zona.
ZONA_HORARIA=America/Monterrey

# ---------------------------------------------------------------------------
# pgAdmin (pestaña de Mantenimiento)
# ---------------------------------------------------------------------------

# Credenciales con las que arranca el contenedor de pgAdmin. Son también las
# que la pestaña de Mantenimiento copia al portapapeles: pgAdmin no admite
# iniciar sesión desde una liga externa (su formulario exige un token CSRF
# propio), así que el botón abre la pestaña con las credenciales listas.
#
# Deliberadamente SIN el prefijo NEXT_PUBLIC_: la contraseña la sirve la API
# a quien tenga sesión de superadministrador, no se incrusta en el bundle
# que descarga cualquiera.
PGADMIN_EMAIL=admin@chwon.it.com
PGADMIN_PASSWORD=CAMBIA_ESTA_CONTRASENA

# URLs de los dos botones. La "local" es la de esta máquina; la de
# producción, la IP del servidor Ubuntu DENTRO de la LAN (no el dominio del
# túnel: pgAdmin no se publica por ahí). Deja vacía la que no aplique y el
# botón aparecerá deshabilitado en lugar de llevar a ningún lado.
PGADMIN_URL_LOCAL=http://localhost:5150
PGADMIN_URL_PRODUCCION=

# ---------------------------------------------------------------------------
# Túnel de Cloudflare
# ---------------------------------------------------------------------------

# Token del túnel que publica el sitio en https://evaluaciones.chwon.it.com.
# Se copia del dashboard de Cloudflare (Zero Trust -> Networks -> Tunnels).
#
# En DESARROLLO déjalo vacío: el contenedor `cloudflared` reinicia en bucle
# quejándose de que le falta el nombre del túnel, pero eso no afecta al resto
# del stack. Para quitarlo del camino mientras desarrollas:
#
#     docker compose stop cloudflared
TUNNEL_TOKEN=

# ---------------------------------------------------------------------------
# Correo saliente (reportes de rondines)
# ---------------------------------------------------------------------------

# Servidor SMTP. Con Gmail se usa una "contraseña de aplicación", no la del
# correo. Déjalo vacío para apagar el envío: el panel seguirá permitiendo
# descargar el Excel.
SMTP_HOST=
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_PASSWORD=
# Remitente. Si se deja vacío se usa SMTP_USUARIO.
SMTP_DESDE=
# true = SMTPS directo (puerto 465); false = STARTTLS (puerto 587).
SMTP_SSL=true

# ---------------------------------------------------------------------------
# Reporte automático de rondines
# ---------------------------------------------------------------------------

# Envía el reporte del turno al cambio de turno (07:30 y 19:30). Corre dentro
# del backend; el candado de la tabla `envios_reporte_rondin` garantiza un
# solo correo aunque uvicorn tenga cuatro workers.
RONDINES_REPORTE_AUTOMATICO=false

# Destinatarios del reporte automático, separados por comas.
RONDINES_DESTINATARIOS=

# ---------------------------------------------------------------------------
# Ingesta de rondines desde AppSheet
# ---------------------------------------------------------------------------

# La captura de rondines la hacen los guardias en una app de AppSheet. Un Bot
# suyo empuja cada escaneo a POST /api/publico/rondin/escaneos con este
# secreto en la cabecera `X-Rondines-Secreto`. Es la ÚNICA credencial de ese
# endpoint: quien lo tenga puede inventar visitas con cualquier hora pasada.
#
# Acúñalo con:  openssl rand -base64 32
# y pega EL MISMO valor en la cabecera del Bot de AppSheet.
# Vacío = el endpoint responde 503 (apagado), nunca abierto.
RONDINES_WEBHOOK_SECRETO=

# Máximo de escaneos por petición. El peor día medido del histórico son 476.
RONDINES_WEBHOOK_MAX_LOTE=500

# ---------------------------------------------------------------------------
# Cierre automático de PCI MTTO
# ---------------------------------------------------------------------------

# Levanta el registro de los meses que terminan sin que nadie conteste si se
# hizo el mantenimiento al sistema contra incendios. Corre dentro del backend;
# la restricción UNIQUE (anio, mes) garantiza una sola fila aunque uvicorn
# tenga cuatro workers. Apagarlo deja huecos en el histórico de cumplimiento.
PCI_CIERRE_AUTOMATICO=true

# ---------------------------------------------------------------------------
# Límite de tasa del escaneo de rondines
# ---------------------------------------------------------------------------

# Más holgado que el del formulario público: un recorrido son decenas de
# escaneos en pocos minutos, y todos los guardias salen por la misma IP del
# NAT de la WiFi de planta.
RATE_LIMIT_RONDIN_ESCANEOS=120
RATE_LIMIT_RONDIN_VENTANA_SEGUNDOS=60

# ---------------------------------------------------------------------------
# Recepciones por foto (OCR + IA)
# ---------------------------------------------------------------------------

# El paso de estructuración lo resuelve un LLM de TEXTO en un Ollama de la
# red. Nunca ve la imagen: solo acomoda el texto que Tesseract ya leyó. Un
# modelo de visión inventaría números de parte y cantidades que no están en
# el papel; así el peor caso es un campo vacío, no un dato inventado.
OLLAMA_HOST=http://192.168.1.56:11434
OLLAMA_TEXT_MODEL=llama3.2:latest

# Piso absoluto del clasificador de formatos (TF-IDF local, sin red). Quien
# decide de verdad es el cociente contra el mejor de OTRO formato, en
# `ocr_recepciones.FACTOR_DISTINCION`: todas las facturas CFDI comparten la
# plantilla del SAT, así que el parecido absoluto sube por igual para todos y
# no distingue. No lo muevas a ojo: se recalibra midiendo (ver `config.py`).
OCR_UMBRAL_SIMILITUD=0.20

# Presupuesto de tiempo en capas, en segundos.
#   PS       -> ¿el modelo ya está cargado en VRAM?
#   FRIO     -> primera llamada tras descargarse de VRAM
#   CALIENTE -> el modelo ya está caliente
OCR_TIMEOUT_PS=5
OCR_TIMEOUT_FRIO=90
OCR_TIMEOUT_CALIENTE=30

# Techo duro de extremo a extremo. DEBE quedar por debajo del
# proxy_read_timeout de Nginx (120 s): si el proxy corta primero, el navegador
# recibe un 500 opaco en vez del 200 con ocr_ok:false que abre la captura
# manual y deja la foto guardada.
OCR_PRESUPUESTO_TOTAL=100

# Tope por foto, en bytes (15 MB). Nginx corta antes en 25 MB.
RECEPCIONES_MAX_BYTES_FOTO=15728640

# Minutos que vive una sesión de captura por QR. Es una de las tres cosas que
# la protegen, junto con el id no adivinable y el uso único.
RECEPCIONES_MINUTOS_SESION_QR=10
